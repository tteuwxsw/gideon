; Engine configuration file for Gideon Avatar
; It's best edited using the editor UI and not directly,
; but since it is all text, you can change it if you like.

config_version=5

[application]

config/name="Gideon Avatar"
config/description="Holographic Desktop Avatar for Gideon AI"
config/version="0.2.0"
run/main_scene="res://scenes/avatar.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width=450
window/size/viewport_height=650
window/size/resizable=true
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[rendering]

viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
